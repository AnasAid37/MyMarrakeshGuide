# Local development defaults. Run `pnpm bootstrap:env` to create a private .env with random secrets.
NODE_ENV=development
APP_NAME=MyMarrakeshGuide API
APP_VERSION=0.1.0
PORT=3001
API_PREFIX=api
API_VERSION=1
LOG_LEVEL=debug
TRUST_PROXY=false
SWAGGER_ENABLED=true

POSTGRES_DB=my_marrakesh_guide
POSTGRES_USER=mmg_app
POSTGRES_PASSWORD=local-development-only-password
DATABASE_URL=postgresql://mmg_app:local-development-only-password@localhost:5432/my_marrakesh_guide?schema=public&connection_limit=20
DATABASE_POOL_MAX=20

REDIS_PASSWORD=local-development-only-redis-password
REDIS_URL=redis://:local-development-only-redis-password@localhost:6379/0

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=local-development-csrf-secret-change-with-bootstrap-env-64chars
JWT_ACCESS_SECRET=local-development-access-secret-change-with-bootstrap-env-64chars
JWT_REFRESH_SECRET=local-development-refresh-secret-change-with-bootstrap-env-64chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

NEXT_PUBLIC_APP_URL=http://localhost:3000
DOCKER_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_ORIGIN=http://localhost:3001

OPENAI_ENABLED=false
OPENAI_API_KEY=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_ENABLED=false
SENTRY_DSN=
