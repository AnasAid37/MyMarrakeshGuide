  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, createdAt])
  @@map("favorites")
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  placeId       String       @map("place_id") @db.Uuid
  rating        Int          @db.SmallInt
  title         String?      @db.VarChar(120)
  body          String       @db.Text
  status        ReviewStatus @default(PENDING)
  moderatedById String?      @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?    @map("moderated_at") @db.Timestamptz(3)
  moderationNote String?     @map("moderation_note") @db.VarChar(500)
