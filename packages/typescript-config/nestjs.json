{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "MyMarrakeshGuide NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "verbatimModuleSyntax": false
  }
}
